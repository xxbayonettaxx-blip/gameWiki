# =====================================================================
# basic_board 環境変数テンプレート（Git管理対象：本物の秘密値はここに入れないこと）
# 使い方: このファイルを .env にコピーし、ID_SECRET と ADMIN_TOKEN を独自のランダム文字列に変更してください。
# 生成例: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# =====================================================================

# 待受ホスト（ローカル試作およびNginxリバースプロキシ配下では 127.0.0.1 固定を推奨）
HOST=127.0.0.1

# 待受ポート（VPS同居の self-dashboard が 3000 番のため 3001 番を使用）
PORT=3001

# SQLite保存先（省略時は ./data/board.db を __dirname 基準で解決）
DB_PATH=./data/board.db

# 【必須】日替わりID生成用の秘密鍵（16文字以上。未設定や見本値のままでは起動エラーになります）
ID_SECRET=CHANGE_ME_TO_RANDOM_SECRET_AT_LEAST_32_CHARS

# 【任意】管理API（論理削除）用の認証トークン（未設定時はHTTP経由の管理削除APIを無効化）
ADMIN_TOKEN=CHANGE_ME_TO_RANDOM_ADMIN_TOKEN_32_CHARS

# Nginx等のローカルリバースプロキシ（127.0.0.1）経由の X-Forwarded-For を信頼するか（true / false）
TRUST_PROXY=false
