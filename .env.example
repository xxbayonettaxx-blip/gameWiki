# =====================================================================
# basic_board 環境変数テンプレート（Git管理対象：本物の秘密値はここに入れないこと）
# 使い方: このファイルを .env にコピーし、ID_SECRET と ADMIN_TOKEN を独自のランダム文字列に変更してください。
# 生成例: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# =====================================================================

# 待受ホスト（ローカル試作およびNginxリバースプロキシ配下では 127.0.0.1 固定を推奨）
HOST=127.0.0.1

# 待受ポート（VPS同居の self-dashboard が 3000 番のため 3001 番を使用）
PORT=3001

# SQLite保存先（省略時は ./data/board.db を __dirname 基準で解決）
DB_PATH=./data/board.db

# 【必須】日替わりID生成用の秘密鍵（16文字以上。未設定や見本値のままでは起動エラーになります）
ID_SECRET=CHANGE_ME_TO_RANDOM_SECRET_AT_LEAST_32_CHARS

# ※ v1.1以降、HTTP管理APIの旧Bearerトークン（ADMIN_TOKEN）は廃止され、
#    管理者アカウントのセッション＋Origin完全一致認可へ統一されました。

# Nginx等のローカルリバースプロキシ（127.0.0.1）経由の X-Forwarded-For / X-Forwarded-Proto を信頼するか（true / false）
TRUST_PROXY=false

# CSRF検証で許可する正規の公開オリジン（scheme+host(+port)のみ。本番例: https://koo-hi.com / テスト例: https://testserver.koo-hi.com）
ALLOWED_ORIGIN=

# Web画面からの新規アカウント登録を受け付けるか（緊急停止時は false に設定）
ALLOW_SIGNUP=true

# ローカルPC等 HTTPS 無しの開発時のみ true に変更可能（本番・テストVPSでは必ず false のまま使用）
DEV_INSECURE_COOKIE=false
