{
  "name": "basic-board",
  "version": "0.5.0",
  "description": "汎用小規模掲示板 MVP (ツリー返信・日替わりID・論理削除・アクセシビリティ対応)",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "sandbox": "node --env-file-if-exists=.env src/sandbox.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "sync-structure": "node --env-file-if-exists=.env src/sync_structure.js",
    "moderate": "node --env-file-if-exists=.env src/moderate.js",
    "backup": "node --env-file-if-exists=.env src/backup.js",
    "test": "node --test test/*.test.js",
    "test:frontend": "node --test test/frontend.browser.cjs"
  },
  "license": "ISC"
}
